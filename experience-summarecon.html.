    <title>Administrative Intern | Natalia</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            line-height: 1.7;
            color: #252525;
            background: #f8f7f4;
        }

        header {
            width: 100%;
            padding: 22px 7%;
            background: rgba(248, 247, 244, 0.96);
            border-bottom: 1px solid #e5e2dc;
        }

        nav {
            max-width: 1100px;
            margin: auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        nav h2 {
            font-size: 20px;
        }

        nav a {
            color: #252525;
            text-decoration: none;
            font-size: 14px;
        }

        nav a:hover {
            color: #9b735d;
        }

        .hero {
            max-width: 1100px;
            margin: auto;
            padding: 110px 7% 90px;
        }

        .label {
            color: #9b735d;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 3px;
            margin-bottom: 20px;
        }

        .hero h1 {
            max-width: 900px;
            font-size: clamp(45px, 7vw, 78px);
            line-height: 1;
            letter-spacing: -4px;
            margin-bottom: 25px;
        }

        .hero h2 {
            max-width: 800px;
            font-size: 23px;
            font-weight: 500;
            color: #555;
            margin-bottom: 20px;
        }

        .hero-description {
            max-width: 750px;
            color: #666;
            font-size: 17px;
        }

        main {
            background: #fff;
        }

        .section {
            max-width: 1100px;
            margin: auto;
            padding: 90px 7%;
        }

        .details {
            display: grid;
            grid-template-columns: 0.8fr 1.2fr;
            gap: 70px;
        }

        .details h2 {
            font-size: 40px;
            line-height: 1.15;
            letter-spacing: -2px;
            margin-bottom: 25px;
        }

        .details p {
            color: #555;
            margin-bottom: 20px;
        }

        .details ul {
            padding-left: 20px;
            color: #555;
        }

        .details li {
            margin-bottom: 12px;
        }

        .documentation {
            background: #f8f7f4;
        }

        .documentation h2 {
            font-size: 40px;
            letter-spacing: -2px;
            margin-bottom: 20px;
        }

        .documentation-intro {
            max-width: 700px;
            color: #666;
            margin-bottom: 45px;
        }

        .gallery {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
        }

        .gallery-item {
            background: #fff;
            border: 1px solid #e3dfd8;
            overflow: hidden;
        }

        .gallery-item img,
        .gallery-item video {
            width: 100%;
            height: auto;
            display: block;
        }

        .gallery-caption {
            padding: 18px 20px;
        }

        .gallery-caption h3 {
            font-size: 17px;
            margin-bottom: 5px;
        }

        .gallery-caption p {
            color: #777;
            font-size: 13px;
        }

        .document-box {
            margin-top: 50px;
            padding: 35px;
            background: #fff;
            border: 1px solid #ddd8d0;
        }

        .document-box h3 {
            margin-bottom: 10px;
        }

        .document-box p {
            color: #666;
            margin-bottom: 20px;
        }

        .button {
            display: inline-block;
            padding: 13px 25px;
            background: #252525;
            color: #fff;
            text-decoration: none;
            border-radius: 4px;
            font-size: 14px;
            font-weight: 600;
            transition: 0.3s ease;
        }

        .button:hover {
            background: #9b735d;
            transform: translateY(-3px);
        }

        footer {
            padding: 30px 7%;
            background: #252525;
            color: #999;
            text-align: center;
            font-size: 12px;
        }

        @media (max-width: 800px) {

            .details {
                grid-template-columns: 1fr;
                gap: 30px;
            }

            .gallery {
                grid-template-columns: 1fr;
            }

            .hero {
                padding-top: 80px;
            }

            .section {
                padding: 70px 7%;
            }

        }

